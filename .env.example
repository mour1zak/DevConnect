# Copie este arquivo para `.env` e preencha com valores reais.

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgres"

# --- Autenticação ---
APIKEY="minha-api-key"
JWT_SECRET="uma-chave-bem-longa-e-segura"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="outra-chave-bem-longa-e-segura"
JWT_REFRESH_EXPIRES_IN="7d"
